# NAME MATTERS: Kamal resolves secrets from exactly two files —
# .kamal/secrets-common and .kamal/secrets<.destination>. With `-d staging`
# it reads this file plus .kamal/secrets.staging, and NEVER a plain
# .kamal/secrets.
#
# DO NOT PUT RAW CREDENTIALS HERE — this file is committed. Every value is
# pulled from the deploying environment; keep real values in
# .kamal/secrets.staging (gitignored) or export them before deploying.

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Postgres: one value under two names. The postgres image needs
# POSTGRES_PASSWORD; Ghostfolio reads a full DATABASE_URL. Export
# POSTGRES_PASSWORD and let DATABASE_URL be composed in the destination file.
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
DATABASE_URL=$DATABASE_URL

# Ghostfolio session/auth secrets. Generate once with `openssl rand -hex 32`
# and keep them stable — rotating ACCESS_TOKEN_SALT invalidates every
# existing security token.
ACCESS_TOKEN_SALT=$ACCESS_TOKEN_SALT
JWT_SECRET_KEY=$JWT_SECRET_KEY
REDIS_PASSWORD=$REDIS_PASSWORD

# NGN Market (Nigerian Exchange) data provider.
API_KEY_NGN_MARKET=$API_KEY_NGN_MARKET

# Daily NGX digest over Resend. Leave the key empty to disable delivery —
# the digest then logs once and skips rather than failing the cron chain.
RESEND_API_KEY=$RESEND_API_KEY
NGX_DIGEST_FROM_EMAIL=$NGX_DIGEST_FROM_EMAIL
NGX_DIGEST_TO_EMAIL=$NGX_DIGEST_TO_EMAIL
